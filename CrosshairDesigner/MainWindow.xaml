<Window x:Class="CrosshairDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Designer" Height="700" Width="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    
    <Grid>
        <!-- Main Window Border -->
        <Border Background="{StaticResource PrimaryBackgroundBrush}" 
                CornerRadius="8" 
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="10">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title and Toggle Switch -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Crosshair Designer" 
                                   Foreground="{StaticResource TextBrush}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        
                        <!-- Toggle Switch in Top Right of Title Area -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                            <TextBlock Text="Crosshair:" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <CheckBox x:Name="CrosshairToggle" 
                                      Style="{StaticResource ModernToggleSwitch}"
                                      Checked="CrosshairToggle_Checked"
                                      Unchecked="CrosshairToggle_Unchecked"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Width="30" Height="30" 
                                Style="{StaticResource ModernButton}"
                                Click="MinimizeButton_Click"
                                Padding="0"/>
                        <Button Content="✕" Width="30" Height="30" 
                                Style="{StaticResource ModernButton}"
                                Click="CloseButton_Click"
                                Padding="0"
                                Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
                
                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Preview Area with Coordinate System -->
                    <Border Grid.Column="0" 
                            Background="{StaticResource SecondaryBackgroundBrush}"
                            Margin="10,0,5,10"
                            CornerRadius="4">
                        <Grid x:Name="PreviewGrid" 
                              Background="Transparent"
                              MouseWheel="PreviewGrid_MouseWheel"
                              MouseDown="PreviewGrid_MouseDown"
                              MouseMove="PreviewGrid_MouseMove"
                              MouseUp="PreviewGrid_MouseUp">
                            
                            <!-- Coordinate System -->
                            <Canvas x:Name="CoordinateCanvas" ClipToBounds="True">
                                <!-- Grid Lines will be drawn here -->
                                <Canvas x:Name="CrosshairCanvas"/>
                            </Canvas>
                            
                            <!-- Zoom Level Indicator -->
                            <Border Background="#AA000000" 
                                    CornerRadius="4" 
                                    Padding="8,4"
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Top"
                                    Margin="10,10,0,0">
                                <TextBlock x:Name="ZoomLevelText" 
                                           Text="Zoom: 100%" 
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12"/>
                            </Border>
                            
                            <!-- Center Crosshair Info -->
                            <Border Background="#AA000000" 
                                    CornerRadius="4" 
                                    Padding="8,4"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Top"
                                    Margin="0,10,0,0">
                                <TextBlock x:Name="CrosshairInfoText" 
                                           Text="X: 0 | Y: 0" 
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Right: Settings Panel -->
                    <Border Grid.Column="1" 
                            Background="{StaticResource SecondaryBackgroundBrush}"
                            Margin="5,0,10,10"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="15">
                                <TextBlock Text="Crosshair Settings" 
                                           Foreground="{StaticResource TextBrush}" 
                                           FontSize="18" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,15"/>
                                
                                <!-- Style Selection -->
                                <TextBlock Text="Style" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="StyleComboBox" 
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="StyleComboBox_SelectionChanged"
                                          Margin="0,0,0,15">
                                    <ComboBoxItem Content="Cross" IsSelected="True"/>
                                    <ComboBoxItem Content="Dot"/>
                                    <ComboBoxItem Content="Circle"/>
                                    <ComboBoxItem Content="Plus"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                                
                                <!-- Color Picker -->
                                <TextBlock Text="Color" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border x:Name="ColorPreviewBorder" 
                                            Width="40" Height="40" 
                                            CornerRadius="4" 
                                            Background="#00FF00"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,10,0"/>
                                    <Button Content="Choose Color" 
                                            Style="{StaticResource ModernButton}"
                                            Click="ChooseColorButton_Click"/>
                                </StackPanel>
                                
                                <!-- Size Slider -->
                                <TextBlock Text="Size" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <Slider x:Name="SizeSlider" 
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="1" Maximum="50" Value="10"
                                        ValueChanged="SizeSlider_ValueChanged"
                                        Margin="0,0,0,15"/>
                                <TextBlock x:Name="SizeValueText" 
                                           Text="Size: 10" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,15"/>
                                
                                <!-- Thickness Slider -->
                                <TextBlock Text="Thickness" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <Slider x:Name="ThicknessSlider" 
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="1" Maximum="20" Value="2"
                                        ValueChanged="ThicknessSlider_ValueChanged"
                                        Margin="0,0,0,15"/>
                                <TextBlock x:Name="ThicknessValueText" 
                                           Text="Thickness: 2" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,15"/>
                                
                                <!-- Opacity Slider -->
                                <TextBlock Text="Opacity" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <Slider x:Name="OpacitySlider" 
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="0.1" Maximum="1.0" Value="1.0"
                                        ValueChanged="OpacitySlider_ValueChanged"
                                        Margin="0,0,0,15"/>
                                <TextBlock x:Name="OpacityValueText" 
                                           Text="Opacity: 100%" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,15"/>
                                
                                <!-- Gap Slider (for cross style) -->
                                <TextBlock Text="Gap" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <Slider x:Name="GapSlider" 
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="0" Maximum="50" Value="0"
                                        ValueChanged="GapSlider_ValueChanged"
                                        Margin="0,0,0,15"/>
                                <TextBlock x:Name="GapValueText" 
                                           Text="Gap: 0" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,15"/>
                                
                                <!-- Center Dot Toggle -->
                                <CheckBox x:Name="CenterDotCheckBox" 
                                          Content="Show Center Dot"
                                          Foreground="{StaticResource TextBrush}"
                                          Margin="0,0,0,15"
                                          Checked="CenterDotCheckBox_Checked"
                                          Unchecked="CenterDotCheckBox_Unchecked"/>
                                
                                <!-- Outline Toggle -->
                                <CheckBox x:Name="OutlineCheckBox" 
                                          Content="Show Outline"
                                          Foreground="{StaticResource TextBrush}"
                                          Margin="0,0,0,15"
                                          Checked="OutlineCheckBox_Checked"
                                          Unchecked="OutlineCheckBox_Unchecked"/>
                                
                                <!-- Reset Button -->
                                <Button Content="Reset to Default" 
                                        Style="{StaticResource ModernButton}"
                                        Click="ResetButton_Click"
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Overlay Crosshair Window (hidden by default) -->
        <Canvas x:Name="OverlayCanvas" Visibility="Collapsed"/>
    </Grid>
</Window>
